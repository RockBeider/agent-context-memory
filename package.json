    "three-tier-memory"
  ],
  "license": "MIT",
  "author": "Rock Beider",
  "type": "commonjs",
  "main": "scripts/group-status.cjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "cms:install": "node scripts/install-template.cjs",
    "git:status": "node scripts/group-status.cjs",
