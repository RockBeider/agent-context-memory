{
  "name": "context-memorial-system",
  "version": "0.1.0",
  "description": "Agentic Three-Tier Context Memorial System & Task-Centric Git Engine",
  "keywords": [
    "ai-agent",
    "context-management",
    "working-memory",
    "long-term-memory",
