{
  "name": "agent-context-memory",
  "version": "0.2.0",
  "description": "Agentic Three-Tier Agent Context Memory & Task-Centric Git Engine",
  "keywords": [
    "ai-agent",
    "context-management",
    "working-memory",
    "long-term-memory",
    "task-centric-commit",
    "three-tier-memory"
  ],
  "homepage": "https://github.com/rockbeider/agent-context-memory#readme",
  "bugs": {
    "url": "https://github.com/rockbeider/agent-context-memory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rockbeider/agent-context-memory.git"
  },
  "license": "MIT",
  "author": "Rock Beider",
  "type": "commonjs",
  "main": "bin/agent-context-memory.js",
  "bin": {
    "agent-context-memory": "bin/agent-context-memory.js",
    "acm": "bin/agent-context-memory.js",
    "context-memory": "bin/agent-context-memory.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "acm-template",
    "scripts",
    "!scripts/sync-dist-branch.cjs",
    "AGENTS.md",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node tests/run-tests.cjs",
    "test:changed": "node tests/run-tests.cjs --changed",
    "test:serial": "node tests/run-tests.cjs --serial",
    "prepublishOnly": "npm test",
    "postinstall": "node scripts/acm/install-template.cjs --postinstall",
    "init": "node bin/agent-context-memory.js init",
    "check-git": "node scripts/acm/check-git.cjs",
    "acm": "node scripts/acm/acm-db-cli.cjs",
    "acm:mcp": "node scripts/acm/mcp-server.cjs",
    "acm:install": "node scripts/acm/install-template.cjs",
    "acm:uninstall": "node scripts/acm/uninstall-template.cjs",
    "acm:status": "node scripts/acm/group-status.cjs --dry-run",
    "acm:summary": "node scripts/acm/group-status.cjs --compact",
    "acm:commit": "node scripts/acm/group-status.cjs --all",
    "acm:pull": "node scripts/acm/smart-pull.cjs",
    "acm:resolve": "node scripts/acm/smart-pull.cjs --resolve",
    "acm:audit-push": "node scripts/acm/audit-push.cjs",
    "dist:sync": "node scripts/sync-dist-branch.cjs",
    "dist:push": "node scripts/sync-dist-branch.cjs --push"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  }
}
